{
  "name": "breezy-web-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "22.22.1",
    "npm": "11.11.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:test": "vue-tsc -p tsconfig.json --noEmit && vite build --mode test",
    "build:prod": "vue-tsc -p tsconfig.json --noEmit && vite build --mode production",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix && npm run format && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "8.0.5",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.34.9",
    "@rollup/rollup-win32-x64-msvc": "^4.34.9"
  }
}
