# ============================================================
# Java / JVM 编译产物
# ============================================================

*.class

# Maven / Gradle / Java 构建目录
target/
build/

# 如果某些模块的 src 目录下确实需要保留 target/build，则取消忽略
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven Wrapper 的 jar 通常不提交；如果团队需要固定 wrapper，可删除此规则
.mvn/wrapper/maven-wrapper.jar


# ============================================================
# Java 打包产物 / 压缩包
# ============================================================

*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar


# ============================================================
# React / Next.js / Node.js 依赖与构建产物
# ============================================================

# Node 依赖目录
node_modules/

# Next.js 构建产物
.next/
out/
next-env.d.ts

# React / Vite / 通用前端构建产物
dist/
dist-ssr/

# 前端构建缓存
.vite/
.turbo/
.parcel-cache/

# TypeScript 增量编译缓存
*.tsbuildinfo

# 测试覆盖率产物
coverage/

# Storybook 静态构建产物
storybook-static/


# ============================================================
# 包管理器缓存 / 状态文件
# ============================================================

.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

.pnpm-store/


# ============================================================
# 环境变量 / 本地配置
# ============================================================

# 所有真实环境变量文件均不提交
.env*

# 保留示例环境变量文件
!.env.example
!.env.*.example

# 其他本地配置文件
*.local


# ============================================================
# 日志文件
# ============================================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


