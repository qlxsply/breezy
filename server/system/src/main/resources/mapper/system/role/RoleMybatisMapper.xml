<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corwin.system.role.infrastructure.persistence.RoleMybatisMapper">

    <resultMap id="RoleResultMap" type="com.corwin.system.role.domain.model.Role">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="enabled" property="enabled"/>
        <result column="system_builtin" property="systemBuiltin"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="page" resultMap="RoleResultMap">
        select id, code, name, description, enabled, system_builtin, created_by, created_at, updated_by, updated_at
        from sys_role
        <where>
            <if test="enabled != null">and enabled = #{enabled}</if>
            <if test="keyword != null">and (code like #{keyword} or name like #{keyword})</if>
        </where>
        <include refid="com.corwin.framework.mybatis.SqlFragments.OrderBy"/>
    </select>
</mapper>
