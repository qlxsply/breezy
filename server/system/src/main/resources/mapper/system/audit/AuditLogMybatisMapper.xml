<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corwin.system.audit.infrastructure.persistence.AuditLogMybatisMapper">

    <resultMap id="AuditLogResultMap" type="com.corwin.system.audit.domain.model.AuditLog">
        <id column="id" property="id"/>
        <result column="trace_id" property="traceId"/>
        <result column="request_id" property="requestId"/>
        <result column="operator_user_id" property="operatorUserId"/>
        <result column="operator_username" property="operatorUsername"/>
        <result column="operator_user_type" property="operatorUserType"/>
        <result column="application_code" property="applicationCode"/>
        <result column="protocol" property="protocol"/>
        <result column="http_method" property="httpMethod"/>
        <result column="path_pattern" property="pathPattern"/>
        <result column="request_uri" property="requestUri"/>
        <result column="permission_codes" property="permissionCodes"/>
        <result column="audit_resource" property="auditResource"/>
        <result column="audit_action" property="auditAction"/>
        <result column="audit_description" property="auditDescription"/>
        <result column="audit_level" property="auditLevel"/>
        <result column="request_ip" property="requestIp"/>
        <result column="user_agent" property="userAgent"/>
        <result column="request_param_summary" property="requestParamSummary"/>
        <result column="request_body_summary" property="requestBodySummary"/>
        <result column="response_summary" property="responseSummary"/>
        <result column="success" property="success"/>
        <result column="error_code" property="errorCode"/>
        <result column="error_message" property="errorMessage"/>
        <result column="started_at" property="startedAt"/>
        <result column="ended_at" property="endedAt"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="AuditLogColumns">
        id, trace_id, request_id, operator_user_id, operator_username, operator_user_type,
        application_code, protocol, http_method, path_pattern, request_uri, permission_codes,
        audit_resource, audit_action, audit_description, audit_level, request_ip, user_agent,
        request_param_summary, request_body_summary, response_summary, success, error_code,
        error_message, started_at, ended_at, duration_ms, created_at
    </sql>

    <select id="pageByQuery" resultMap="AuditLogResultMap">
        select
        <include refid="AuditLogColumns"/>
        from sys_audit_log
        <where>
            <if test="query != null">
                <if test="query.traceId != null">
                    and trace_id like #{query.traceId}
                </if>
                <if test="query.operatorUserId != null">
                    and operator_user_id = #{query.operatorUserId}
                </if>
                <if test="query.operatorUsername != null">
                    and operator_username like #{query.operatorUsername}
                </if>
                <if test="query.applicationCode != null">
                    and application_code = #{query.applicationCode}
                </if>
                <if test="query.requestUri != null">
                    and request_uri like #{query.requestUri}
                </if>
                <if test="query.auditResource != null">
                    and audit_resource like #{query.auditResource}
                </if>
                <if test="query.auditAction != null">
                    and audit_action like #{query.auditAction}
                </if>
                <if test="query.auditLevel != null">
                    and audit_level = #{query.auditLevel}
                </if>
                <if test="query.success != null">
                    and success = #{query.success}
                </if>
                <if test="query.startAt != null">
                    and created_at &gt;= #{query.startAt}
                </if>
                <if test="query.endAt != null">
                    and created_at &lt; #{query.endAt}
                </if>
            </if>
        </where>
        <include refid="com.corwin.framework.mybatis.SqlFragments.OrderBy"/>
    </select>

</mapper>
