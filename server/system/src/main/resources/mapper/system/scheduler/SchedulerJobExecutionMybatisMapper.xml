<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corwin.system.scheduler.infrastructure.persistence.SchedulerJobExecutionMybatisMapper">

    <resultMap id="ExecutionResultMap" type="com.corwin.system.scheduler.domain.model.SchedulerJobExecution">
        <id column="execution_id" property="executionId"/>
        <result column="job_id" property="jobId"/>
        <result column="scheduled_time" property="scheduledTime"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="execution_result" property="result"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="trigger_type" property="triggerType"/>
        <result column="result_code" property="resultCode"/>
        <result column="result_message" property="resultMessage"/>
        <result column="error_message" property="errorMessage"/>
        <result column="error_stack" property="errorStack"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="pageByJobId" resultMap="ExecutionResultMap">
        select execution_id, job_id, scheduled_time, start_time, end_time, execution_result, duration_ms,
        trigger_type, result_code, result_message, error_message, error_stack, created_at
        from sched_job_execution
        where job_id = #{jobId}
        order by start_time desc
    </select>
</mapper>
