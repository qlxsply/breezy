<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corwin.system.userfeature.infrastructure.persistence.UserApplicationPackageMybatisMapper">

    <resultMap id="PackageResultMap" type="com.corwin.system.userfeature.domain.model.UserApplicationPackage">
        <id column="id" property="id"/>
        <result column="package_code" property="packageCode"/>
        <result column="package_name" property="packageName"/>
        <result column="package_type" property="packageType"/>
        <result column="description" property="description"/>
        <result column="enabled" property="enabled"/>
        <result column="default_package" property="defaultPackage"/>
        <result column="system_built_in" property="systemBuiltIn"/>
        <result column="display_order" property="displayOrder"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Columns">
        id, package_code, package_name, package_type, description, enabled, default_package, system_built_in,
        display_order, created_by, created_at, updated_by, updated_at
    </sql>

    <select id="page" resultMap="PackageResultMap">
        select
        <include refid="Columns"/>
        from sys_user_application_package
        <where>
            <if test="enabled != null">and enabled = #{enabled}</if>
            <if test="keyword != null">
                and concat(coalesce(package_code, ''), ' ', coalesce(package_name, '')) like #{keyword}
            </if>
        </where>
        <include refid="com.corwin.framework.mybatis.SqlFragments.OrderBy"/>
    </select>
</mapper>
