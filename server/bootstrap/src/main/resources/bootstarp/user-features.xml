<?xml version="1.0" encoding="UTF-8"?>
<user-features xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="user-features.xsd">

    <applications>
        <application code="jsonfmt"
                     name="JSON工具"
                     enabled="true"
                     sortNo="10"
                     icon="jsonfmt"
                     routePath="/jsonfmt"
                     componentPath="pages/JsonFormatterPage.vue">
            <description>JSON格式化、记录、比对</description>
            <features>
                <feature code="BASE" name="基础功能" enabled="true" sortNo="10">
                    <description>JSON工具基础功能</description>
                    <permissions>
                        <permission code="jfm.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="reminder"
                     name="提醒事项"
                     enabled="true"
                     sortNo="20"
                     icon="reminder"
                     routePath="/todo"
                     componentPath="pages/TodoBoardPage.vue">
            <description>日程、提醒、待办</description>
            <features>
                <feature code="BASE" name="基础功能" enabled="true" sortNo="10">
                    <description>提醒事项基础功能</description>
                    <permissions>
                        <permission code="tdo.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="datasource"
                     name="数据源"
                     enabled="true"
                     sortNo="30"
                     icon="datasource"
                     routePath="/datasource"
                     componentPath="pages/DataSourceAdminPage.vue">
            <description>数据源管理</description>
            <features>
                <feature code="BASE" name="基础功能" enabled="true" sortNo="10">
                    <description>数据源管理基础功能</description>
                    <permissions>
                        <permission code="ds.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="schemaforge"
                     name="数据库结构工具"
                     enabled="true"
                     sortNo="40"
                     icon="schemaforge"
                     routePath="/schemaforge"
                     componentPath="pages/SchemaForgePage.vue">
            <description>数据库快照、备份、比对</description>
            <features>
                <feature code="BASE" name="基础功能" enabled="true" sortNo="10">
                    <description>数据库结构工具基础功能</description>
                    <permissions>
                        <permission code="sfg.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="storage"
                     name="个人云盘"
                     enabled="true"
                     sortNo="50"
                     icon="storage"
                     routePath="/storage"
                     componentPath="pages/StoragePage.vue">
            <description>个人云盘</description>
            <features>
                <feature code="BASE" name="基础功能" enabled="true" sortNo="10">
                    <description>存储空间基础功能</description>
                    <permissions>
                        <permission code="stg.use"/>
                    </permissions>
                </feature>
            </features>
