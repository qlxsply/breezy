<?xml version="1.0" encoding="UTF-8"?>
<user-features xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="user-features.xsd">

    <applications>
        <application code="jsonfmt"
                     name="JSON 工具"
                     enabled="true"
                     sortNo="10"
                     icon="icons/applications/jsonfmt.svg"
                     routePath="/jsonfmt"
                     componentPath="pages/JsonFormatterPage.vue">
            <description>JSON 格式化与记录管理能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入 JSON 工具并使用其核心能力。</description>
                    <permissions>
                        <permission code="jfm.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="reminder"
                     name="提醒事项"
                     enabled="true"
                     sortNo="20"
                     icon="icons/applications/reminder.svg"
                     routePath="/todo"
                     componentPath="pages/TodoBoardPage.vue">
            <description>提醒、日程与待办能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入提醒事项并使用其核心能力。</description>
                    <permissions>
                        <permission code="tdo.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="datasource"
                     name="数据源"
                     enabled="true"
                     sortNo="30"
                     icon="icons/applications/datasource.svg"
                     routePath="/datasource"
                     componentPath="pages/DataSourceAdminPage.vue">
            <description>数据源连接、元数据与库表管理能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入数据源并使用其核心能力。</description>
                    <permissions>
                        <permission code="ds.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="schemaforge"
                     name="SchemaForge"
                     enabled="true"
                     sortNo="40"
                     icon="icons/applications/schemaforge.svg"
                     routePath="/schemaforge"
                     componentPath="pages/SchemaForgePage.vue">
            <description>数据库快照、DDL 与结构比对能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入 SchemaForge 并使用其核心能力。</description>
                    <permissions>
                        <permission code="sfg.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="storage"
                     name="存储空间"
                     enabled="true"
                     sortNo="50"
                     icon="icons/applications/storage.svg"
                     routePath="/storage"
                     componentPath="pages/StoragePage.vue">
            <description>个人文件存储与目录管理能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入存储空间并使用其核心能力。</description>
                    <permissions>
                        <permission code="stg.use"/>
                    </permissions>
                </feature>
            </features>
        </application>

        <application code="clinic"
                     name="诊所业务"
                     enabled="true"
                     sortNo="60"
                     icon="icons/applications/clinic.svg"
                     routePath="/clinic/management"
                     componentPath="pages/clinic/ClinicManagementPage.vue">
            <description>诊所商品、库存、采购、销售与台账能力。</description>
            <features>
                <feature code="USE" name="使用应用" enabled="true" sortNo="10">
                    <description>允许进入诊所业务并使用其核心能力。</description>
                    <permissions>
                        <permission code="cln.use"/>
                    </permissions>
                </feature>
            </features>
        </application>
    </applications>
</user-features>
