<?xml version="1.0" encoding="UTF-8"?>
<normal-features xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:noNamespaceSchemaLocation="normal-features.xsd">

    <feature code="jsonfmt" name="JSON 工具" enabled="true" sortNo="10">
        <description>JSON 格式化与记录管理能力。</description>
        <permissions>
            <permission code="jfm.use"/>
        </permissions>
    </feature>

    <feature code="reminder" name="提醒事项" enabled="true" sortNo="20">
        <description>提醒、日程与待办能力。</description>
        <permissions>
            <permission code="tdo.use"/>
        </permissions>
    </feature>

    <feature code="datasource" name="数据源" enabled="true" sortNo="30">
        <description>数据源连接、元数据与库表管理能力。</description>
        <permissions>
            <permission code="ds.use"/>
        </permissions>
    </feature>

    <feature code="schemaforge" name="SchemaForge" enabled="true" sortNo="40">
        <description>数据库快照、DDL 与结构比对能力。</description>
        <permissions>
            <permission code="sfg.use"/>
        </permissions>
    </feature>

    <feature code="storage" name="存储空间" enabled="true" sortNo="50">
        <description>个人文件存储与目录管理能力。</description>
        <permissions>
            <permission code="stg.use"/>
        </permissions>
    </feature>

    <feature code="clinic" name="诊所业务" enabled="true" sortNo="60">
        <description>诊所商品、库存、采购、销售与台账能力。</description>
        <permissions>
            <permission code="cln.use"/>
        </permissions>
    </feature>

</normal-features>
