<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corwin.datasource.infrastructure.persistence.DatabaseTableMybatisMapper">

    <resultMap id="DatabaseTableResultMap" type="com.corwin.datasource.domain.model.DatabaseTable">
        <id column="id" property="id"/>
        <result column="database_id" property="databaseId"/>
        <result column="data_source_id" property="dataSourceId"/>
        <result column="alias" property="alias"/>
        <result column="table_catalog" property="tableCatalog"/>
        <result column="table_schema" property="tableSchema"/>
        <result column="table_name" property="tableName"/>
        <result column="table_type" property="tableType"/>
        <result column="remark_db" property="remarkDb"/>
        <result column="remark_custom" property="remarkCustom"/>
    </resultMap>

    <sql id="Columns">
        id, database_id, data_source_id, alias, table_catalog, table_schema, table_name, table_type, remark_db,
        remark_custom
    </sql>

    <select id="pageByQuery" resultMap="DatabaseTableResultMap">
        select
        <include refid="Columns"/>
        from db_table
        <where>
            database_id = #{query.databaseId}
            <if test="query.tableSchema != null">and table_schema = #{query.tableSchema}</if>
            <if test="query.tableNameLike != null">and table_name like #{query.tableNameLike}</if>
            <if test="query.tableType != null">and table_type = #{query.tableType}</if>
        </where>
        <include refid="com.corwin.framework.mybatis.SqlFragments.OrderBy"/>
    </select>
</mapper>
