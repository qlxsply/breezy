<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.corwin.framework.mybatis.SqlFragments">

    <sql id="OrderBy">
        <if test="spec != null and spec.sorts != null and !spec.sorts.isEmpty()">
            order by
            <foreach collection="spec.sorts" item="sort" separator=",">
                <choose>
                    <when test="sort.direction != null and sort.direction.name() == 'DESC'">
                        ${sort.field} desc
                    </when>
                    <otherwise>
                        ${sort.field} asc
                    </otherwise>
                </choose>
            </foreach>
        </if>
    </sql>

</mapper>
